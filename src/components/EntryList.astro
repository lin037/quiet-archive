---
import type { ContentEntry } from '../api/types';

export interface Props {
  entries: ContentEntry[];
  showType?: boolean;
}

const { entries, showType = false } = Astro.props;
---

<div class="entry-trail-container">
  <div class="trail-line"></div>
  <ul class="entry-list">
    {entries.map((entry, index) => (
      <li class={`entry-item ${index % 2 !== 0 ? 'staggered' : ''}`}>
        <div class="trail-node"></div>
        <a href={entry.uri} class="entry-link">
          <div class="entry-main">
            <h3 class="entry-title">{entry.title}</h3>
            {entry.summary && <p class="entry-summary">{entry.summary}</p>}
          </div>
          <div class="entry-aside">
            {showType && <span class="entry-type">{entry.typeSlug}</span>}
            {entry.date && <time class="entry-date" datetime={entry.date}>{entry.date.slice(0, 10)}</time>}
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .entry-trail-container {
    position: relative;
    padding-left: var(--space-6);
  }

  .trail-line {
    position: absolute;
    top: var(--space-6);
    bottom: var(--space-6);
    left: 8px; /* Offset to center the line */
    width: 2px;
    background: linear-gradient(to bottom, var(--color-accent-soft), var(--color-border), transparent);
    z-index: 0;
  }

  .entry-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
    z-index: 1;
  }

  .entry-item {
    position: relative;
    display: flex;
    align-items: center;
    transition: transform var(--duration-normal) var(--ease-default);
  }

  .entry-item.staggered {
    transform: translateX(24px);
  }

  .trail-node {
    position: absolute;
    left: calc(-1 * var(--space-6) + 3px);
    width: 12px;
    height: 12px;
    background: var(--color-bg);
    border: 3px solid var(--color-accent);
    border-radius: 50%;
    z-index: 2;
    transition: transform var(--duration-normal) var(--ease-default),
                background var(--duration-fast) var(--ease-default);
  }

  .entry-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-8);
    text-decoration: none;
    border-radius: var(--radius-xl) var(--radius-xl) var(--radius-xl) 4px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-normal) var(--ease-default);
  }

  /* Staggered items have different rounded corners to look organic */
  .entry-item.staggered .entry-link {
    border-radius: var(--radius-xl) var(--radius-xl) 4px var(--radius-xl);
  }

  .entry-item:hover .entry-link {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px) scale(1.01);
  }

  .entry-item:hover .trail-node {
    transform: scale(1.5);
    background: var(--color-accent);
  }

  .entry-main {
    flex: 1;
    min-width: 0;
  }

  .entry-title {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--leading-snug);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .entry-link:hover .entry-title {
    color: var(--color-accent);
  }

  .entry-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .entry-aside {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .entry-type {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .entry-date {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .entry-item.staggered {
      transform: none; /* Remove stagger on mobile */
    }
    
    .entry-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5);
      border-radius: var(--radius-lg) !important;
    }

    .entry-aside {
      width: 100%;
      justify-content: space-between;
      order: -1;
    }
  }
</style>
