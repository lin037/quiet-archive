---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import EntryList from '../components/EntryList.astro';
import { getBreadcrumb } from '../api/navigation';
import { getSubDirectories, getEntriesInDir } from '../api/content';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import type { ContentEntry } from '../api/types';

export interface Props {
  entry: ContentEntry;
}

const { entry } = Astro.props;

const breadcrumb = await getBreadcrumb(entry.uri);
const subDirs = await getSubDirectories(entry.dirPath);
const childEntries = await getEntriesInDir(entry.dirPath);

// Render README content if exists
const posts = await getCollection('posts');
const rawEntry = posts.find(p => p.id === entry.id);

let Content: any = null;
if (rawEntry) {
  const rendered = await render(rawEntry);
  Content = rendered.Content;
}
---

<PageLayout title={`${entry.title} — 静档`} description={entry.summary || entry.description || ''}>
  <article class="directory-page">
    <Breadcrumb items={breadcrumb} />

    <header class="dir-header">
      <h1 class="dir-title">{entry.title}</h1>
      {entry.summary && <p class="dir-summary">{entry.summary}</p>}
    </header>

    {/* README body content */}
    {Content && (
      <div class="prose dir-intro">
        <Content />
      </div>
    )}

    {/* Sub-directories */}
    {subDirs.length > 0 && (
      <section class="dir-section">
        <h2 class="dir-section-title">子目录</h2>
        <div class="subdir-grid">
          {subDirs.map((dir) => (
            <a href={dir.uri} class="subdir-card">
              <div class="subdir-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
              </div>
              <div class="subdir-info">
                <span class="subdir-name">{dir.title}</span>
                {dir.summary && <span class="subdir-desc">{dir.summary}</span>}
              </div>
              <svg class="subdir-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Direct child entries */}
    {childEntries.length > 0 && (
      <section class="dir-section">
        {subDirs.length > 0 && <h2 class="dir-section-title">内容</h2>}
        <EntryList entries={childEntries} />
      </section>
    )}

    {subDirs.length === 0 && childEntries.length === 0 && !Content && (
      <p class="dir-empty">此目录暂无内容。</p>
    )}
  </article>
</PageLayout>

<style>
  .directory-page {
    width: 100%;
  }

  .dir-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .dir-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }

  .dir-summary {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .dir-intro {
    margin-bottom: var(--space-10);
  }

  .dir-section {
    margin-bottom: var(--space-10);
  }

  .dir-section-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .subdir-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .subdir-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-fast) var(--ease-default),
                background var(--duration-fast) var(--ease-default);
  }

  .subdir-card:hover {
    border-color: var(--color-text-tertiary);
    background: var(--color-accent-soft);
  }

  .subdir-icon {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }

  .subdir-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .subdir-name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .subdir-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subdir-arrow {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .subdir-card:hover .subdir-arrow {
    opacity: 1;
  }

  .dir-empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }
</style>
