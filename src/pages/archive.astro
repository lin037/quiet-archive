---
import PageLayout from '../layouts/PageLayout.astro';
import { getAllEntries } from '../api/content';
import type { ContentEntry } from '../api/types';

const entries = await getAllEntries();

// Group by year
const byYear: Record<string, ContentEntry[]> = {};
for (const entry of entries) {
  const year = entry.date ? entry.date.slice(0, 4) : '未标注';
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(entry);
}

const years = Object.keys(byYear).sort((a, b) => b.localeCompare(a));
---

<PageLayout title="归档 — 静档" description="所有已发布内容的时间归档。">
  <header class="page-header">
    <h1 class="page-title">归档</h1>
    <p class="page-count">{entries.length} 篇内容</p>
  </header>

  {years.map((year) => (
    <section class="year-group">
      <h2 class="year-title">{year}</h2>
      <ul class="year-list">
        {byYear[year].map((entry) => (
          <li class="archive-item">
            <a href={entry.uri} class="archive-link">
              <time class="archive-date">{entry.date ? entry.date.slice(5, 10) : ''}</time>
              <span class="archive-title">{entry.title}</span>
              <span class="archive-type">{entry.typeSlug}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</PageLayout>

<style>
  .page-header {
    margin-bottom: var(--space-12);
  }

  .page-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
  }

  .page-count {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
  }

  .year-group {
    margin-bottom: var(--space-10);
  }

  .year-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
    letter-spacing: var(--tracking-wide);
  }

  .year-list {
    list-style: none;
    padding: 0;
  }

  .archive-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .archive-item:last-child {
    border-bottom: none;
  }

  .archive-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .archive-link:hover {
    opacity: 0.7;
  }

  .archive-date {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
    min-width: 3.5em;
    flex-shrink: 0;
  }

  .archive-title {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 450;
  }

  .archive-type {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }
</style>
