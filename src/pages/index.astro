---
import PageLayout from '../layouts/PageLayout.astro';
import EntryList from '../components/EntryList.astro';
import { getRecentEntries, getFeaturedEntries, getNavTypes } from '../api/content';
import { getArchiveStats } from '../api/stats';
import { resolveAssetSrc } from '../api/assets';

const recent = await getRecentEntries(6);
const featured = await getFeaturedEntries();
const types = await getNavTypes();
const stats = await getArchiveStats();

const heroImg = resolveAssetSrc('/assets/placeholders/download-1.png');
const typeImages = [
  resolveAssetSrc('/assets/placeholders/download-4.png'),
  resolveAssetSrc('/assets/placeholders/download-2.png'),
  resolveAssetSrc('/assets/placeholders/download-5.png'),
  resolveAssetSrc('/assets/placeholders/download.png'),
];
---

<PageLayout title="静档 — 个人技术档案馆" description="一个安静的个人档案馆，收录文章、笔记与专栏。" wide={true}>
  
  <!-- Editorial Hero -->
  <section class="hero-editorial">
    <div class="hero-text-block">
      <div class="hero-badge">个人技术档案馆</div>
      <h1 class="hero-title">静档<br/>Archive</h1>
      <p class="hero-desc">
        在这里收录长文思考、灵感碎片与主题专栏。<br/>
        扎根于文件系统，如森林般自然生长。
      </p>
      
      <div class="hero-stats">
        <div class="stat-bubble">
          <span class="stat-val">{stats.total}</span>
          <span class="stat-lbl">篇内容</span>
        </div>
        <div class="stat-bubble">
          <span class="stat-val">{stats.byType.length}</span>
          <span class="stat-lbl">个分区</span>
        </div>
        <div class="stat-bubble">
          <span class="stat-val">{stats.tags.length}</span>
          <span class="stat-lbl">个标签</span>
        </div>
      </div>
    </div>
    <div class="hero-image-block">
      <div class="blob-image-wrapper">
        <img src={heroImg} alt="Forest ambient" class="blob-image" loading="eager" />
        <div class="blob-overlay"></div>
      </div>
      <div class="blob-decor decorative-circle"></div>
      <div class="blob-decor decorative-dots"></div>
    </div>
  </section>

  <!-- Interactive Bento Grid for Types -->
  <section class="types-bento">
    <div class="section-label">内容分区 <span>/ Collections</span></div>
    <div class="bento-grid">
      {types.map((t, i) => (
        <a href={`/${t.slug}`} class={`bento-card bento-card-${i % 4}`}>
          <div class="bento-bg">
            <img src={typeImages[i % typeImages.length]} alt="" loading="lazy" />
            <div class="bento-glass"></div>
          </div>
          <div class="bento-content">
            <div class="bento-top">
              <span class="bento-count">{stats.byType.find(b => b.slug === t.slug)?.count || 0} 篇</span>
            </div>
            <div class="bento-bottom">
              <h3 class="bento-title">{t.title}</h3>
              {t.description && <p class="bento-desc">{t.description}</p>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Split Layout: Featured & Recent -->
  <section class="split-layout">
    <!-- Featured Column -->
    <div class="split-left">
      <div class="section-label sticky-label">精选内容 <span>/ Featured</span></div>
      <div class="featured-stack">
        {featured.map((entry, i) => (
          <a href={entry.uri} class="featured-editorial-card">
            <div class="fe-number">{String(i + 1).padStart(2, '0')}</div>
            <div class="fe-content">
              <span class="fe-type">{entry.typeSlug}</span>
              <h3 class="fe-title">{entry.title}</h3>
              {entry.summary && <p class="fe-summary">{entry.summary}</p>}
              <time class="fe-date">{entry.date.slice(0, 10)}</time>
            </div>
            <div class="fe-arrow">→</div>
          </a>
        ))}
      </div>
    </div>

    <!-- Recent Column -->
    <div class="split-right">
      <div class="section-header">
        <div class="section-label">最新动态 <span>/ Recent</span></div>
        <a href="/archive" class="section-more">全部归档</a>
      </div>
      <div class="recent-trail">
        <EntryList entries={recent} showType={true} />
      </div>
    </div>
  </section>
  
</PageLayout>

<style>
  /* ─── Shared ─── */
  .section-label {
    font-size: var(--text-base);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-6);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  
  .section-label span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-accent);
    opacity: 0.8;
  }

  /* ─── Editorial Hero ─── */
  .hero-editorial {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    margin-top: var(--space-16);
    margin-bottom: var(--space-32);
    min-height: 50vh;
  }

  .hero-text-block {
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tighter);
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero-desc {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-10);
    max-width: 90%;
  }

  .hero-stats {
    display: flex;
    gap: var(--space-6);
  }

  .stat-bubble {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stat-val {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .stat-lbl {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-1);
  }

  /* Organic Blob Image */
  .hero-image-block {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    max-width: 500px;
    margin: 0 auto;
  }

  .blob-image-wrapper {
    position: absolute;
    inset: 0;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    overflow: hidden;
    box-shadow: var(--shadow-image);
    animation: morph 8s ease-in-out infinite alternate;
    z-index: 2;
  }

  .blob-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1); /* Prevent edge clipping during morph */
  }

  .blob-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(46,150,86,0.4) 0%, rgba(13,18,15,0.1) 100%);
    mix-blend-mode: overlay;
  }

  .decorative-circle {
    position: absolute;
    bottom: -5%;
    left: -10%;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    z-index: 1;
    filter: blur(40px);
  }

  .decorative-dots {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 150px;
    height: 150px;
    background-image: radial-gradient(var(--color-accent) 2px, transparent 2px);
    background-size: 16px 16px;
    opacity: 0.2;
    z-index: 1;
    border-radius: 50%;
  }

  @keyframes morph {
    0% { border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; }
    100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
  }

  /* ─── Bento Grid ─── */
  .types-bento {
    margin-bottom: var(--space-32);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 240px;
    gap: var(--space-6);
  }

  .bento-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    group: bento;
    transition: transform var(--duration-normal) var(--ease-default),
                box-shadow var(--duration-normal) var(--ease-default);
  }

  /* Asymmetric spans */
  .bento-card-0 { grid-column: span 2; grid-row: span 2; } /* Large square */
  .bento-card-1 { grid-column: span 2; grid-row: span 1; } /* Wide horizontal */
  .bento-card-2 { grid-column: span 1; grid-row: span 1; } /* Small square */
  .bento-card-3 { grid-column: span 1; grid-row: span 1; } /* Small square */

  .bento-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--shadow-image);
    z-index: 10;
  }

  .bento-bg {
    position: absolute;
    inset: 0;
  }

  .bento-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-default);
  }

  .bento-glass {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-bg) 0%, transparent 80%);
    opacity: 0.9;
    transition: opacity var(--duration-normal) var(--ease-default);
  }
  
  [data-theme="dark"] .bento-glass {
    background: linear-gradient(to top, var(--color-bg) 0%, transparent 90%);
  }

  .bento-card:hover .bento-bg img {
    transform: scale(1.08);
  }

  .bento-card:hover .bento-glass {
    opacity: 0.95;
    background: linear-gradient(to top, var(--color-bg) 0%, var(--color-accent-soft) 100%);
  }

  .bento-content {
    position: absolute;
    inset: 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 2;
  }

  .bento-top {
    display: flex;
    justify-content: flex-end;
  }

  .bento-count {
    font-size: var(--text-xs);
    font-weight: 700;
    background: var(--color-bg-elevated);
    color: var(--color-text);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  .bento-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .bento-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }
  
  .bento-card:hover .bento-title {
    color: var(--color-accent);
  }

  /* ─── Split Layout ─── */
  .split-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-16);
    margin-bottom: var(--space-20);
  }

  .sticky-label {
    position: sticky;
    top: 100px; /* Below floating header */
  }

  .featured-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured-editorial-card {
    display: flex;
    gap: var(--space-6);
    text-decoration: none;
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    transition: all var(--duration-normal) var(--ease-default);
    position: relative;
    overflow: hidden;
  }
  
  .featured-editorial-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0; width: 4px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform var(--duration-normal) var(--ease-default);
  }

  .featured-editorial-card:hover {
    transform: translateX(8px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  
  .featured-editorial-card:hover::before {
    transform: scaleY(1);
  }

  .fe-number {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 300;
    color: var(--color-border);
    line-height: 0.8;
    transition: color var(--duration-normal) var(--ease-default);
  }
  
  .featured-editorial-card:hover .fe-number {
    color: var(--color-accent);
  }

  .fe-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fe-type {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .fe-title {
    font-size: var(--text-xl);
    font-family: var(--font-display);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .fe-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .fe-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
  }

  .fe-arrow {
    font-size: var(--text-xl);
    color: var(--color-text-tertiary);
    align-self: center;
    transform: translateX(0);
    transition: all var(--duration-normal) var(--ease-default);
    opacity: 0;
  }
  
  .featured-editorial-card:hover .fe-arrow {
    opacity: 1;
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .section-more {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .section-more:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .hero-editorial {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-10);
    }
    
    .hero-stats {
      justify-content: center;
    }

    .hero-desc {
      margin: 0 auto var(--space-8);
    }
    
    .blob-image-wrapper {
      max-width: 400px;
    }
    
    .split-layout {
      grid-template-columns: 1fr;
    }
    
    .sticky-label {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    
    .bento-card {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
      min-height: 200px;
    }
    
    .hero-title {
      font-size: var(--text-4xl);
    }
  }
</style>
