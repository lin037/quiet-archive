---
import PageLayout from '../../layouts/PageLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { discoverTypes, getEntriesByType, getSubDirectories, getEntriesInDir } from '../../api/content';
import type { TypeMeta } from '../../api/types';

export async function getStaticPaths() {
  const types = await discoverTypes();
  return types.map((t: TypeMeta) => ({
    params: { type: t.slug },
    props: { typeMeta: t },
  }));
}

const { typeMeta } = Astro.props;

// Get direct entries (non-directory content in this type root)
const allEntries = await getEntriesByType(typeMeta.slug);
const directEntries = await getEntriesInDir(typeMeta.slug);
const subDirs = await getSubDirectories(typeMeta.slug);

// If this type has subdirectories, show directory-style layout
// If not, show flat entry list
const hasStructure = subDirs.length > 0;
---

<PageLayout title={`${typeMeta.title} — 静档`} description={typeMeta.description || ''}>
  <header class="type-header">
    <h1 class="type-title">{typeMeta.title}</h1>
    {typeMeta.description && <p class="type-desc">{typeMeta.description}</p>}
    <span class="type-count">{allEntries.length} 篇内容</span>
  </header>

  {hasStructure && (
    <section class="dir-section">
      <div class="subdir-grid">
        {subDirs.map((dir) => (
          <a href={dir.uri} class="subdir-card">
            <div class="subdir-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <div class="subdir-info">
              <span class="subdir-name">{dir.title}</span>
              {dir.summary && <span class="subdir-desc">{dir.summary}</span>}
            </div>
            <svg class="subdir-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        ))}
      </div>
    </section>
  )}

  {directEntries.length > 0 && (
    <section class="entries-section">
      {hasStructure && <h2 class="section-title">其他内容</h2>}
      <EntryList entries={directEntries} />
    </section>
  )}

  {!hasStructure && allEntries.length > 0 && (
    <EntryList entries={allEntries} />
  )}

  {allEntries.length === 0 && subDirs.length === 0 && (
    <p class="empty">暂无内容</p>
  )}
</PageLayout>

<style>
  .type-header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .type-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-2);
  }

  .type-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .type-count {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .dir-section {
    margin-bottom: var(--space-10);
  }

  .section-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .entries-section {
    margin-bottom: var(--space-8);
  }

  .subdir-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .subdir-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: border-color var(--duration-fast) var(--ease-default),
                background var(--duration-fast) var(--ease-default);
  }

  .subdir-card:hover {
    border-color: var(--color-text-tertiary);
    background: var(--color-accent-soft);
  }

  .subdir-icon {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }

  .subdir-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .subdir-name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
  }

  .subdir-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subdir-arrow {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .subdir-card:hover .subdir-arrow {
    opacity: 1;
  }

  .empty {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }
</style>
